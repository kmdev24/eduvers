{
    "buildCommand": "npm run build",
    "outputDirectory": "public",
    "functions": {
        "api/index.php": { "runtime": "vercel-php@0.7.4" }
    },
    "routes": [
        { "src": "/(build|images)/(.*)", "dest": "/$1/$2" },
        { "src": "/(favicon\\.ico|robots\\.txt)", "dest": "/$1" },
        { "src": "/(.*)", "dest": "/api/index.php" }
    ]
}
