# ── EduVers ──────────────────────────────────────────────
# Environment files (secrets). Only .env.example is committed.
.env.*
!.env.example

# Local databases, SQL dumps and backups (may contain personal data)
/database/*.sqlite
/database/*.sqlite-journal
*.sql
*.sql.gz
/backups

# Project archives / backups (may contain .env and data)
*.zip
*.rar
*.7z

# Uploaded lesson files / videos (private storage)
/storage/app/private/*
!/storage/app/private/.gitignore
/storage/app/public/*
!/storage/app/public/.gitignore

# Vite fonts manifest (generated)
/public/fonts-manifest*.json

# Local Docker overrides
docker-compose.override.yml
