# ─────────────────────────────────────────────────────────────────────────
# EduVers on Railway + TiDB Cloud — service variables
# Railway → your service → Variables → Raw Editor → paste, then replace
# every <…> placeholder. Never commit the filled-in version.
# ─────────────────────────────────────────────────────────────────────────

APP_NAME=EduVers
APP_ENV=production
APP_DEBUG=false
APP_KEY=<output of: php artisan key:generate --show>
APP_URL=https://${{RAILWAY_PUBLIC_DOMAIN}}
APP_TIMEZONE=Asia/Manila

# Apache inside the container listens on this port
PORT=8080

LOG_CHANNEL=stderr
LOG_LEVEL=warning

# ── TiDB Cloud (MySQL-compatible). Values from TiDB Cloud → your cluster → Connect ──
DB_CONNECTION=mysql
DB_HOST=<gateway01.ap-southeast-1.prod.aws.tidbcloud.com>
DB_PORT=4000
DB_DATABASE=eduvers
DB_USERNAME=<yourPrefix.root>
DB_PASSWORD=<your TiDB password>
# TiDB Cloud only accepts TLS connections; this is the CA bundle inside the Docker image
MYSQL_ATTR_SSL_CA=/etc/ssl/certs/ca-certificates.crt

SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
FILESYSTEM_DISK=local

# Emails go through the database queue; the container runs a worker for it
QUEUE_CONNECTION=database

# ── Email alerts ── Railway's Free/Trial/Hobby plans block SMTP, so send
# through Brevo's HTTPS API (free: 300 emails/day). Brevo → SMTP & API → API keys.
# The From address must be a sender you verified in Brevo.
MAIL_MAILER=brevo
BREVO_API_KEY=<your Brevo API key>
MAIL_FROM_ADDRESS=<your verified sender, e.g. eduvers.mite@gmail.com>
MAIL_FROM_NAME=EduVers
NOTIFICATIONS_MAIL=true

# Container start-up behaviour (docker/entrypoint.sh)
RUN_MIGRATIONS=true
SEED_DEMO_DATA=false
RUN_QUEUE_WORKER=true
