APP_NAME=EduVers
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Manila

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL (Laragon defaults). Create the "eduvers" database first (HeidiSQL or: mysql -u root -e "CREATE DATABASE eduvers CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci")
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=eduvers
DB_USERNAME=root
DB_PASSWORD=

# ── Cloud databases (production) ─────────────────────────────────────────
# Set these in your host's dashboard (e.g. Render → Environment), NOT in a
# committed file. A DB_URL overrides DB_HOST / DB_PORT / DB_DATABASE / etc.
#
# PostgreSQL (Render's managed database — use its "Internal Database URL"):
# DB_CONNECTION=pgsql
# DB_URL=postgresql://USERNAME:PASSWORD@HOST:5432/DATABASE
# DB_SSLMODE=prefer
#
# TiDB Cloud (MySQL-compatible, TLS required, port 4000). Use the values from
# TiDB Cloud → cluster → Connect. The username includes your cluster prefix.
# DB_CONNECTION=mysql
# DB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
# DB_PORT=4000
# DB_DATABASE=eduvers
# DB_USERNAME=yourPrefix.root
# DB_PASSWORD=your-password
# MYSQL_ATTR_SSL_CA=/etc/ssl/certs/ca-certificates.crt
#
# MySQL (managed MySQL such as Aiven, DigitalOcean, AWS RDS):
# DB_CONNECTION=mysql
# DB_URL=mysql://USERNAME:PASSWORD@HOST:3306/DATABASE
# MYSQL_ATTR_SSL_CA=/etc/ssl/certs/ca-certificates.crt

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Emails to students are queued. Keep a worker running while you develop:
#   php artisan queue:work
# (In-app bell notifications appear instantly even without a worker.)
# Use QUEUE_CONNECTION=sync to send emails during the request instead (slower pages).
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── Email alerts (new lessons, quizzes, announcements) ───────────────────
# "log" writes emails to storage/logs/laravel.log instead of sending them.
# Pick ONE of the options below for real sending.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Set to false to keep in-app notifications but stop email alerts
NOTIFICATIONS_MAIL=true

# Option A: Mailtrap Email Testing (local development — catches every email
# in a fake inbox, nothing reaches students). Mailtrap → Sandboxes → SMTP.
# MAIL_MAILER=smtp
# MAIL_HOST=sandbox.smtp.mailtrap.io
# MAIL_PORT=2525
# MAIL_USERNAME=your-mailtrap-username
# MAIL_PASSWORD=your-mailtrap-password
# MAIL_FROM_ADDRESS="no-reply@eduvers.test"

# Option B: Gmail SMTP (needs 2-Step Verification + an App Password from
# myaccount.google.com/apppasswords — not your normal Gmail password).
# Gmail allows roughly 500 emails/day.
# MAIL_MAILER=smtp
# MAIL_SCHEME=smtp
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=your.address@gmail.com
# MAIL_PASSWORD=your-16-character-app-password
# MAIL_FROM_ADDRESS="your.address@gmail.com"

# Option C: Brevo HTTPS API (use on Railway: its Free/Trial/Hobby plans block
# SMTP). Brevo → SMTP & API → API keys; verify your sender address first.
# MAIL_MAILER=brevo
# BREVO_API_KEY=xkeysib-your-api-key
# MAIL_FROM_ADDRESS="your.verified.sender@gmail.com"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ── Production settings (set in the host dashboard) ─────────────────────
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://eduvers.onrender.com
# LOG_CHANNEL=stderr
# LOG_LEVEL=warning
# SESSION_SECURE_COOKIE=true
# RUN_MIGRATIONS=true        # container runs "php artisan migrate --force" on start
# SEED_DEMO_DATA=false       # "true" once for demo accounts; never in real production
# RUN_QUEUE_WORKER=true      # container also runs "php artisan queue:work" for queued emails
